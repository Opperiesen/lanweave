{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Opperiesen/lanweave/blob/main/docs/contracts/adapter-capabilities-v1.schema.json",
  "title": "Lanweave adapter capabilities format v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "adapter", "auth_modes", "resources"],
  "properties": {
    "format_version": { "const": 1 },
    "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "auth_modes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "operations"],
      "properties": {
        "resource": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["read", "export", "plan", "apply", "prune"]
          }
        }
      }
    }
  }
}
