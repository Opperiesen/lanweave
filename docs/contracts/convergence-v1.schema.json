{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Opperiesen/lanweave/blob/main/docs/contracts/convergence-v1.schema.json",
  "title": "Lanweave post-apply convergence result format v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "read_only",
    "state",
    "plan_summary",
    "affected_resources",
    "summary",
    "resources",
    "recovery"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "read_only": { "const": true },
    "state": { "enum": ["converged", "drifted", "uncertain", "unsupported"] },
    "target": { "$ref": "#/$defs/target" },
    "capabilities": { "type": "object" },
    "plan_summary": { "$ref": "#/$defs/plan_summary" },
    "affected_resources": {
      "type": "array",
      "items": { "enum": ["networks", "wlans", "dns", "firewall", "nat", "vpn"] }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "recovery": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "controller", "site"],
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "controller": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "site": { "type": "string", "minLength": 1 },
        "adapter": {
          "enum": ["local-classic", "cloud-site-manager"],
          "default": "local-classic"
        }
      }
    },
    "plan_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "update", "delete", "noop"],
      "properties": {
        "create": { "type": "integer", "minimum": 0 },
        "update": { "type": "integer", "minimum": 0 },
        "delete": { "type": "integer", "minimum": 0 },
        "noop": { "type": "integer", "minimum": 0 },
        "reorder": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["converged", "drifted", "uncertain", "unsupported"],
      "properties": {
        "converged": { "type": "integer", "minimum": 0 },
        "drifted": { "type": "integer", "minimum": 0 },
        "uncertain": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "state",
        "declared_count",
        "observed_count",
        "findings"
      ],
      "properties": {
        "resource": {
          "enum": ["networks", "wlans", "dns", "firewall", "nat", "vpn"]
        },
        "state": { "enum": ["converged", "drifted", "uncertain", "unsupported"] },
        "declared_count": { "type": ["integer", "null"], "minimum": 0 },
        "observed_count": { "type": ["integer", "null"], "minimum": 0 },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["missing", "extra", "changed"] },
        "name": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["uncertain", "unsupported"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
