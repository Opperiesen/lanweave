{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Opperiesen/lanweave/blob/main/docs/contracts/config-v1.schema.json",
  "title": "Lanweave configuration schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "controller", "networks", "wlans"],
  "properties": {
    "version": { "const": 1 },
    "controller": { "$ref": "#/$defs/controller" },
    "networks": {
      "type": "array",
      "items": { "$ref": "#/$defs/network" }
    },
    "wlans": {
      "type": "array",
      "items": { "$ref": "#/$defs/wlan" }
    },
    "dns": {
      "type": "array",
      "items": { "$ref": "#/$defs/dns_record" }
    },
    "firewall": {
      "$ref": "#/$defs/firewall"
    },
    "nat": {
      "type": "array",
      "items": { "$ref": "#/$defs/nat_mapping" }
    }
  },
  "$defs": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site"],
      "properties": {
        "site": { "type": "string", "minLength": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "enum": ["corporate", "guest", "vlan-only", "wan"] },
        "subnet": { "type": "string", "minLength": 1 },
        "vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "domain_name": { "type": "string" },
        "dhcp": { "$ref": "#/$defs/dhcp" },
        "ipv6": { "$ref": "#/$defs/ipv6" }
      }
    },
    "dhcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "start": { "type": "string" },
        "stop": { "type": "string" },
        "lease_time": { "type": "integer", "exclusiveMinimum": 0 },
        "dns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ipv6": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string" }
      }
    },
    "wlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ssid", "network", "bands", "security"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ssid": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1 },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["2g", "5g", "6g"] }
        },
        "security": { "enum": ["open", "wpa2", "wpa3", "wpa3-transition"] },
        "password": {
          "type": "string",
          "pattern": "^\\$\\{[A-Z_][A-Z0-9_]*\\}$"
        },
        "password_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "enabled": { "type": "boolean" },
        "hide_ssid": { "type": "boolean" },
        "fast_roaming": { "type": "boolean" },
        "proxy_arp": { "type": "boolean" },
        "pmf": { "enum": ["disabled", "optional", "required"] },
        "client_isolation": { "type": "boolean" },
        "multicast_enhancement": { "type": "boolean" },
        "schedule_enabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "not": {
            "required": ["password", "password_env"]
          }
        },
        {
          "if": {
            "properties": { "security": { "const": "open" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["password"] },
                { "required": ["password_env"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "security": {
                "enum": ["wpa2", "wpa3", "wpa3-transition"]
              }
            }
          },
          "then": {
            "anyOf": [
              { "required": ["password"] },
              { "required": ["password_env"] }
            ]
          }
        }
      ]
    },
    "dns_record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "address"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
            "type": { "const": "A" },
            "address": { "type": "string", "format": "ipv4" },
            "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "enabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "address"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
            "type": { "const": "AAAA" },
            "address": { "type": "string", "format": "ipv6" },
            "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "enabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "target"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
            "type": { "const": "CNAME" },
            "target": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
            "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
            "enabled": { "type": "boolean" }
          }
        }
      ]
    },
    "firewall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/firewall_zone" }
        },
        "address_groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/address_group" }
        },
        "port_groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/port_group" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/firewall_rule" }
        }
      }
    },
    "nat_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "public", "private"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "protocol": { "enum": ["TCP", "UDP", "TCP_UDP"] },
        "ip_version": { "enum": ["IPV4", "IPV6"] },
        "public": { "$ref": "#/$defs/nat_public" },
        "source": { "$ref": "#/$defs/nat_source" },
        "private": { "$ref": "#/$defs/nat_private" },
        "hairpin": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "nat_public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "port"],
      "properties": {
        "interface": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "port": { "$ref": "#/$defs/port_item" }
      }
    },
    "nat_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zone": { "type": "string", "minLength": 1 },
        "addresses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nat_private": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "port"],
      "properties": {
        "network": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "port": { "$ref": "#/$defs/port_item" }
      }
    },
    "firewall_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "networks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "address_item": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "stop"],
          "properties": {
            "start": { "type": "string", "minLength": 1 },
            "stop": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "address_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "addresses"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/address_item" }
        }
      }
    },
    "port_item": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 65535 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "stop"],
          "properties": {
            "start": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "stop": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      ]
    },
    "port_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ports"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/port_item" }
        }
      }
    },
    "firewall_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone"],
      "properties": {
        "zone": { "type": "string", "minLength": 1 },
        "networks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "address_group": { "type": "string", "minLength": 1 },
        "port_group": { "type": "string", "minLength": 1 },
        "match_opposite": { "type": "boolean" },
        "port_match_opposite": { "type": "boolean" }
      }
    },
    "firewall_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "order", "source", "destination", "action"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "placement": { "enum": ["before_system_defined", "after_system_defined"] },
        "source": { "$ref": "#/$defs/firewall_side" },
        "destination": { "$ref": "#/$defs/firewall_side" },
        "action": { "enum": ["ALLOW", "BLOCK", "REJECT"] },
        "enabled": { "type": "boolean" },
        "ip_version": { "enum": ["IPV4", "IPV4_AND_IPV6", "IPV6"] },
        "protocol": {
          "enum": [
            "AH", "DCCP", "ESP", "GRE", "ICMP", "ICMPV6", "IGMP", "IP",
            "IPCOMP", "IPENCAP", "IPIP", "L2TP", "OSPF", "PIM", "SCTP", "TCP",
            "TCP_UDP", "UDP", "UDPLITE", "VRRP"
          ]
        },
        "protocol_number": { "type": "integer", "minimum": 0, "maximum": 255 },
        "connection_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["NEW", "INVALID", "ESTABLISHED", "RELATED"] }
        },
        "ipsec": { "enum": ["MATCH_ENCRYPTED", "MATCH_NOT_ENCRYPTED"] },
        "logging": { "type": "boolean" },
        "allow_return_traffic": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "not": {
            "required": ["protocol", "protocol_number"]
          }
        }
      ]
    }
  }
}
