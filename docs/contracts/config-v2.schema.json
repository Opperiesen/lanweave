{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Opperiesen/lanweave/blob/main/docs/contracts/config-v2.schema.json",
  "title": "Lanweave configuration schema v2",
  "description": "Version-2 local profile configuration composed with the version-1 resource definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "controllers", "profiles", "networks", "wlans"],
  "properties": {
    "version": { "const": 2 },
    "profile": { "$ref": "profile-layer-v2.schema.json#/$defs/identifier" },
    "controllers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "$ref": "profile-layer-v2.schema.json#/$defs/controller"
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "$ref": "profile-layer-v2.schema.json#/$defs/profile"
      }
    },
    "networks": {
      "type": "array",
      "items": { "$ref": "config-v1.schema.json#/$defs/network" }
    },
    "wlans": {
      "type": "array",
      "items": { "$ref": "config-v1.schema.json#/$defs/wlan" }
    },
    "dns": {
      "type": "array",
      "items": { "$ref": "config-v1.schema.json#/$defs/dns_record" }
    },
    "firewall": {
      "$ref": "config-v1.schema.json#/$defs/firewall"
    }
  }
}
